    "views": [
      {
        "viewName": "reading_book_rows",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT r.sourceId, r.snapshotKey, r.path, COALESCE(b.title, r.path) AS title,\n        r.availability, b.author, r.progress, b.coverUri, r.status, r.lastReadAt, r.historyOrder,\n        f.fingerprint, r.currentPage, r.totalPages, b.description\n    FROM reading_items r JOIN book_files f ON f.id=r.fileId JOIN books b ON b.id=f.bookId"
      },
      {
        "viewName": "library_book_rows",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT l.sourceId, l.folderKey, l.path, COALESCE(b.title, l.path) AS title,\n        b.author, b.coverUri, f.fingerprint, l.progress, l.status, b.description, f.checksum\n    FROM library_books l JOIN book_files f ON f.id=l.fileId JOIN books b ON b.id=f.bookId"
      }
    ],
